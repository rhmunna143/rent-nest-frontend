            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Tenant User\",\n  \"email\": \"newtenant@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"TENANT\",\n  \"phone\": \"+1-555-0199\",\n  \"profileImage\": \"https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80\"\n}"
            },
            "url": {
              "raw": "{{devBaseUrl}}/api/auth/register",
              "host": [
                "{{devBaseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Register a new user (TENANT or LANDLORD). Enforces password policy: >=8 chars, uppercase, lowercase, digit."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tenant@rentnest.com\",\n  \"password\": \"Demo@1234\"\n}"
            },
            "url": {
              "raw": "{{devBaseUrl}}/api/auth/login",
              "host": [
                "{{devBaseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Authenticate user. Sets HTTP-only accessToken and refreshToken cookies, and returns user object and tokens in JSON response."
          }
        },
        {
          "name": "Google OAuth Sign-in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
