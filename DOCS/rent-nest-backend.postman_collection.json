            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"mock-google-token-tenant\",\n  \"role\": \"TENANT\"\n}"
            },
            "url": {
              "raw": "{{devBaseUrl}}/api/auth/google",
              "host": [
                "{{devBaseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "google"
              ]
            },
            "description": "Sign in with Google. Verifies idToken via google-auth-library. Requires role on first sign-in."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
