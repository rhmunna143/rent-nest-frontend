            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"\"\n}"
            },
            "url": {
              "raw": "{{devBaseUrl}}/api/auth/refresh-token",
              "host": [
                "{{devBaseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh-token"
              ]
            },
            "description": "Rotates refresh token and issues a new access token. Revokes token family on token reuse."
          }
        },
